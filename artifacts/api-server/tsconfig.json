{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "lib": ["es2022", "dom"],
    "noEmitOnError": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/report-engine"
    }
  ],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "rootDir": "."
    }
  }
}
